{"repo": {"timestamp": 1791659416000, "version": 20002, "name": "Frequencies", "icon": "icon.png", "address": "https://frequencies.vpavlin.xyz/fdroid/repo", "description": "Scala, the local-first shared calendar, for Android (by vpavlin)."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "vpavlin", "categories": ["Internet"], "suggestedVersionCode": "3", "description": "Private, decentralized event organisation for the music and club scene: nights by venue and status, line-ups with set times and fees, artists from Kith, double-booking warnings, comments. Built on Scala's end-to-end-encrypted calendars and the Loam shared node (install Loam too).", "license": "Unknown", "name": "Frequencies", "sourceCode": "https://github.com/vpavlin/frequencies", "summary": "Organise club nights on shared Scala calendars", "added": 1791657529000, "packageName": "xyz.vpavlin.frequencies", "lastUpdated": 1791659408000}, {"authorName": "vpavlin", "categories": ["Internet"], "suggestedVersionCode": "6", "description": "Kith is the contacts app of the Loam ecosystem: a local-first, peer-to-peer address book. A contact can carry a Loam identity, turning it into a grantable principal for other apps (Scala editors, Qaku admins). Books sync across your devices; import/export vCards.", "license": "Unknown", "name": "Kith", "sourceCode": "https://github.com/vpavlin/kith", "summary": "Your people \u2014 a local-first, p2p address book on Loam", "added": 1791657530000, "packageName": "xyz.vpavlin.kith", "lastUpdated": 1791657530000, "localized": {"en-US": {"icon": "icon_LUl-_zRXwLtE5bygHgHZak7ZpkSj1x3astkyenMOxp8=.png"}}}, {"authorName": "vpavlin", "categories": ["System"], "suggestedVersionCode": "55", "description": "Loam is the soil your Logos apps grow in: one shared Logos Delivery node per phone, used by every app over IPC, so ten apps don't each run their own node. Per-app consent, end-to-end encrypted (Loam only ever moves sealed bytes), and an opt-in offline cache that holds a closed app's messages so it reopens without re-syncing. It also runs a Bluetooth LE mesh, so nearby phones sync with no internet at all.", "license": "Unknown", "name": "Loam", "sourceCode": "https://github.com/vpavlin/loam", "summary": "The shared node your local-first apps grow in \u2014 one Logos Delivery node per phone", "added": 1791657532000, "packageName": "xyz.vpavlin.loam", "lastUpdated": 1791657534000, "localized": {"en-US": {"icon": "icon_SdidZ-XV5g3OSqZ3Z-47JHxuMxapRVVb2gAghQkTJjc=.png"}}}, {"authorName": "vpavlin", "categories": ["Internet"], "suggestedVersionCode": "139", "description": "Secure, server-less shared calendar on Logos/Loam: E2E-encrypted, multi-writer, offline-first. RSVP, recurring events, custom fields, .ics import/export, Keycard identity.", "license": "Unknown", "name": "Scala", "sourceCode": "https://github.com/vpavlin/scala", "summary": "Local-first, end-to-end-encrypted shared calendar", "added": 1791545154000, "packageName": "xyz.vpavlin.scala", "lastUpdated": 1791659415000, "localized": {"en-US": {"icon": "icon_daWTbIfADRdwjYnKhC22ZOF5nTnebBG8uRtIssaURUQ=.png"}}}], "packages": {"xyz.vpavlin.frequencies": [{"added": 1791659408000, "apkName": "frequencies-0.3.0.apk", "hash": "3d67b53e0cfdcb20a1fda8377197d207443d1ad5469a4b3faa94eff56d4034dc", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a"], "packageName": "xyz.vpavlin.frequencies", "sig": "8634ee2cdbbf5833da40ea11a84b3afe", "signer": "8ce7c3897be61c1159b48b6cf5eb2a1999f258e9e5cbee3cc94ec5feae71c249", "size": 40940161, "targetSdkVersion": 36, "uses-permission": [["android.permission.CAMERA", null], ["android.permission.INTERNET", null], ["android.permission.NFC", null], ["android.permission.READ_EXTERNAL_STORAGE", 32], ["android.permission.RECORD_AUDIO", null], ["android.permission.SYSTEM_ALERT_WINDOW", null], ["android.permission.VIBRATE", null], ["android.permission.WRITE_EXTERNAL_STORAGE", 32], ["co.logos.delivery.permission.BIND", null], ["andr